#include <stdio.h>
int main() {
    int n, i, sum1 = 0, sum2 = 0;
    scanf("%d", &n);
    int arr[n];
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    for(i = 0; i < n / 2; i++) {
        sum1 += arr[i];
    }
    for(i = n / 2; i < n; i++) {
        sum2 += arr[i];
    }
    if(sum1 == sum2) {
        printf("BALANCED\n");
    } else {
        printf("NOT BALANCED\n");
    }
    return 0;
}
